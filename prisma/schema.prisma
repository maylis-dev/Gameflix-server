// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
 
 
}



model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  username      String?
  photoProfile  String?
  bio           String?
  gender        String?
  preferences   String?
  createdAt     DateTime @default(now())

  // Relations
  comments      Comment[]
  likes         Like[]
  memberships   GroupMember[]
  chats         ChatMember[]
  messages      Message[]
  events        EventMember[]

  // Groups créés/admin
  groupsOwned   Group[] @relation("GroupAdmin")

  // Events créés
  createdEvents Event[] @relation("EventCreator")
}

model Place {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  country     String
  city        String
  address     String?

  // 1 = cheap / 2 = medium / 3 = expensive
  priceLevel  Int?

  // calm / noisy / social / silent
  ambiance    String?

  photoPlace  String?

  createdAt   DateTime @default(now())

  // Relations
  comments    Comment[]
  likes       Like[]
  events      Event[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  // Auteur
  user      User @relation(fields: [userId], references: [id])
  userId    Int

  // Place commentée
  place     Place @relation(fields: [placeId], references: [id])
  placeId   Int
}

model Like {
  user      User @relation(fields: [userId], references: [id])
  userId    Int

  place     Place @relation(fields: [placeId], references: [id])
  placeId   Int

  createdAt DateTime @default(now())

  @@id([userId, placeId])
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  description String?

  // groupe public ou privé
  isPrivate   Boolean  @default(false)

  // code pour rejoindre groupe privé
  joinCode    String?

  photoGroup  String?

  createdAt   DateTime @default(now())

  // Admin du groupe
  adminId     Int
  admin       User @relation("GroupAdmin", fields: [adminId], references: [id])

  // Relations
  members     GroupMember[]
  messages    Message[] @relation("GroupMessages")
}

model GroupMember {
  user      User @relation(fields: [userId], references: [id])
  userId    Int

  group     Group @relation(fields: [groupId], references: [id])
  groupId   Int

  // admin / member
  role      String @default("member")

  joinedAt  DateTime @default(now())

  @@id([userId, groupId])
}

model Chat {
  id        Int      @id @default(autoincrement())
  name      String?

  createdAt DateTime @default(now())

  // Relations
  members   ChatMember[]
  messages  Message[] @relation("ChatMessages")

  // Chat lié à un event (optionnel)
  event     Event? @relation("EventChat")
}

model ChatMember {
  user    User @relation(fields: [userId], references: [id])
  userId  Int

  chat    Chat @relation(fields: [chatId], references: [id])
  chatId  Int

  joinedAt DateTime @default(now())

  @@id([userId, chatId])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  // Auteur
  user      User @relation(fields: [userId], references: [id])
  userId    Int

  // Message dans un groupe
  group      Group? @relation("GroupMessages", fields: [groupId], references: [id])
  groupId    Int?

  // Message dans un chat
  chat       Chat? @relation("ChatMessages", fields: [chatId], references: [id])
  chatId     Int?
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?

  createdAt   DateTime @default(now())

  // Date/heure meetup
  time        DateTime

  // calm / noisy / medium
  noiseLevel  String?

  maxPeople   Int?

  // Place liée à l'event
  placeId     Int?
  place       Place? @relation(fields: [placeId], references: [id])

  // Créateur event
  creatorId   Int
  creator     User @relation("EventCreator", fields: [creatorId], references: [id])

  // Participants
  members     EventMember[]

  // Chat de l'event
  chatId      Int? @unique
  chat        Chat? @relation("EventChat", fields: [chatId], references: [id])
}

model EventMember {
  user    User @relation(fields: [userId], references: [id])
  userId  Int

  event   Event @relation(fields: [eventId], references: [id])
  eventId Int

  joinedAt DateTime @default(now())

  @@id([userId, eventId])
}